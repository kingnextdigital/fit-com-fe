# =============================================================
# TREINO CRISTÃO AI — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais
# =============================================================

# Supabase (obrigatório)
# Encontre em: supabase.com > seu projeto > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OpenAI (opcional — ativa o treinador IA de verdade)
# Sem essa chave o treinador funciona com respostas pré-definidas
VITE_OPENAI_API_KEY=sk-...

# App
VITE_APP_NAME=Treino Cristão AI
VITE_APP_URL=http://localhost:5173
